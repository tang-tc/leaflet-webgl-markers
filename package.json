{
  "name": "@tang-tc/leaflet-webgl-markers",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the leaflet-webgl-markers library and its demo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build:lib": "npm run build -w leaflet-webgl-markers",
    "build": "npm run build:lib && npm run build -w demo",
    "dev": "npm run dev -w demo",
    "lint": "oxlint packages/leaflet-webgl-markers/src packages/leaflet-webgl-markers/tests demo/src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vitest": "^3.2.7"
  }
}
